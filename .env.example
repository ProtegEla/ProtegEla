# ==============================================================================
# ProtegEla - Variáveis de Ambiente Globais (Exemplo Simplificado)
# Copie este arquivo para .env no ambiente de desenvolvimento local.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND (FastAPI)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
APP_SECRET_KEY=dev_secret_key_protegela_minimo_32_caracteres_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Banco de Dados (PostgreSQL Local ou Nuvem/Supabase)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/protegela_db

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006,exp://localhost:8081

# ------------------------------------------------------------------------------
# FRONTEND / MOBILE (Expo)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_ENVIRONMENT=development
