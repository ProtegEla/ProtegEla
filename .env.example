# ==============================================================================
# ProtegEla - Variáveis de Ambiente Globais (Exemplo)
# Copie este arquivo para .env no ambiente de desenvolvimento local.
# NUNCA envie chaves ou senhas reais para o controle de versão (Git).
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND (FastAPI & PostgreSQL Local)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
APP_SECRET_KEY=substitua_por_uma_chave_aleatoria_com_ao_menos_32_caracteres_em_producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Criptografia de Dados Sensíveis em Repouso (LGPD: e-mails, contatos de emergência)
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=substitua_por_chave_fernet_32_bytes_base64_valida

# Banco de Dados PostgreSQL (Instalação Local Nativa)
POSTGRES_USER=protegela_user
POSTGRES_PASSWORD=protegela_secret_dev_pass
POSTGRES_DB=protegela_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://protegela_user:protegela_secret_dev_pass@localhost:5432/protegela_db
DATABASE_SYNC_URL=postgresql://protegela_user:protegela_secret_dev_pass@localhost:5432/protegela_db

# CORS (origens separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006,exp://localhost:8081

# Integrações de APIs Externas
# Overpass API (OSM)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=15

# OpenRouteService API
OPENROUTESERVICE_API_URL=https://api.openrouteservice.org
OPENROUTESERVICE_API_KEY=sua_chave_openrouteservice_aqui
OPENROUTESERVICE_TIMEOUT_SECONDS=10

# ------------------------------------------------------------------------------
# FRONTEND / MOBILE (Expo)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_ENVIRONMENT=development
