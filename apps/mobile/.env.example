# ==============================================================================
# Configurações do Aplicativo Mobile Expo (Copie para apps/mobile/.env)
# ==============================================================================

# URL Base da API do ProtegEla (Emulador Android: http://10.0.2.2:8000/api/v1)
# Em dispositivo físico via rede local: http://<SEU_IP_LOCAL>:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_ENVIRONMENT=development
