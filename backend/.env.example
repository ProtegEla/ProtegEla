# ==============================================================================
# Configurações do Back-end FastAPI (Copie para backend/.env)
# ==============================================================================
ENVIRONMENT=development
DEBUG=True
# No Supabase compartilhado: DEBUG=false e a mesma chave JWT fornecida pela equipe.
# O valor abaixo é apenas um exemplo local; não serve para o ambiente compartilhado.
APP_SECRET_KEY=dev_secret_key_change_in_production_min_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7


# Recuperação de senha. Configure as credenciais no ambiente do backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Em produção, use a URL HTTPS pública da tela de redefinição.
PASSWORD_RESET_URL=

# Obrigatória: chave Fernet. Veja como gerar e conservar em docs/local_setup.md.
# Para protegela-dev, obtenha a chave existente com a equipe; não gere outra.
FIELD_ENCRYPTION_KEY=


# Banco de dados PostgreSQL (Instalação Local Nativa com extensão PostGIS)
POSTGRES_USER=protegela_user
POSTGRES_PASSWORD=protegela_secret_dev_pass
POSTGRES_DB=protegela_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# POSTGRES_* não constrói nem atualiza as URLs automaticamente. Ajuste-as também.
DATABASE_URL=postgresql+asyncpg://protegela_user:protegela_secret_dev_pass@localhost:5432/protegela_db
DATABASE_SYNC_URL=postgresql+psycopg2://protegela_user:protegela_secret_dev_pass@localhost:5432/protegela_db

# Supabase compartilhado (substitua o marcador no arquivo privado; não use literalmente):
# DATABASE_URL=postgresql+asyncpg://protegela_app:<SENHA_CODIFICADA>@db.ddydjthhtanqbaaotsse.supabase.co:5432/postgres?ssl=verify-full
# Codifique caracteres especiais da senha para URL. Nunca publique a URL preenchida.
# A aplicação não usa postgres. DATABASE_SYNC_URL administrativo é restrito aos
# responsáveis pelas migrações; veja docs/local_setup.md para psycopg2 e verify-full.
# Exporte no terminal que iniciará o Python (ajuste o caminho do certificado):
# export PGSSLROOTCERT="$HOME/.config/protegela/protegela-dev-ca.crt"
# export PGSSLMINPROTOCOLVERSION=TLSv1.2
# Colocar PGSSLROOTCERT somente neste .env não a exporta para o asyncpg:
# o Pydantic não transfere essas opções para o ambiente do processo.
# Use DEBUG=false e as três chaves estáveis da equipe no ambiente compartilhado.

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006,exp://localhost:8081

# Integrações Externas
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=10
OPENROUTESERVICE_API_URL=https://api.heigit.org/openrouteservice
OPENROUTESERVICE_API_KEY=mock_dev_key
OPENROUTESERVICE_TIMEOUT_SECONDS=8
OPENROUTESERVICE_AUTOCOMPLETE_URL=https://api.heigit.org/pelias/v1/autocomplete
ADDRESS_SEARCH_REQUESTS_PER_MINUTE=60
ROUTE_REQUESTS_PER_MINUTE=10

# Obrigatória: segredo estável para buscar e-mails. Não trocar em bancos existentes.
# Para protegela-dev, reutilize o mesmo segredo da equipe, assim como as outras chaves.
FIELD_LOOKUP_KEY=
