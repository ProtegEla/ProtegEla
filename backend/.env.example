# ==============================================================================
# Configurações do Back-end FastAPI (Copie para backend/.env)
# ==============================================================================
ENVIRONMENT=development
DEBUG=True
APP_SECRET_KEY=dev_secret_key_change_in_production_min_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Criptografia simétrica para campos sensíveis em repouso (LGPD)
FIELD_ENCRYPTION_KEY=dGhpcy1pcy1hLWRldmVsb3BtZW50LWtleS1mb3ItZmVybmV0PQ==

# Banco de dados PostgreSQL (Instalação Local Nativa com extensão PostGIS)
POSTGRES_USER=protegela_user
POSTGRES_PASSWORD=protegela_secret_dev_pass
POSTGRES_DB=protegela_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://protegela_user:protegela_secret_dev_pass@localhost:5432/protegela_db
DATABASE_SYNC_URL=postgresql://protegela_user:protegela_secret_dev_pass@localhost:5432/protegela_db

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006,exp://localhost:8081

# Integrações Externas
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=10
OPENROUTESERVICE_API_URL=https://api.openrouteservice.org
OPENROUTESERVICE_API_KEY=mock_dev_key
OPENROUTESERVICE_TIMEOUT_SECONDS=8
