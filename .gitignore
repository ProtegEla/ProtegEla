# ==========================================
# ProtegEla - Root .gitignore (Monorepo)
# ==========================================

# Ambientes e Segredos
.env
.env.local
.env.*.local
*.env
!.env.example
!apps/mobile/.env.example
!backend/.env.example

# IDEs e Editores
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Python & Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node & JavaScript / TypeScript
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
lerna-debug.log*

# Expo & React Native
.expo/
.expo-shared/
web-build/
dist/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Android & iOS builds
apps/mobile/android/
apps/mobile/ios/

# Logs e arquivos temporários
logs/
*.log
tmp/
temp/
